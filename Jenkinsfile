pipeline
{
    agent any
    {
        stages{
            stage("Checkout"){
            
            steps
            {
                echo "Checking out the code from the repository"
            }
            }
        
        stage("Build"){

            steps
            {
                echo "Building the code"
            }
        }
        stage("Test"){

            steps
            {
                echo "Running the tests"
            }
        }
        stage("Deploy"){
            steps
            {
                echo "Deploying the application"
               }
                  }
        }
        }
    }
